{
  "$defs": {
    "ErrorType": {
      "enum": [
        "STATEMENT_MISREAD",
        "CONSTRAINT_OMISSION",
        "WRONG_ALGORITHM",
        "PROOF_GAP",
        "CIRCULAR_REASONING",
        "HALLUCINATED_CLAIM",
        "COMPLEXITY_TLE",
        "COMPLEXITY_MLE",
        "BOUNDARY_ERROR",
        "INTEGER_OVERFLOW",
        "STATE_TRANSITION_ERROR",
        "IMPLEMENTATION_MISMATCH",
        "IO_OR_FORMAT_ERROR",
        "COMPILE_ERROR",
        "RUNTIME_ERROR",
        "RESULT_CORRECT_PROCESS_INVALID",
        "UNRESOLVED"
      ],
      "title": "ErrorType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "error_type": {
      "$ref": "#/$defs/ErrorType"
    },
    "first_error_step_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Error Step Id"
    },
    "code_location": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code Location"
    },
    "evidence": {
      "items": {
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "final_result_correct": {
      "title": "Final Result Correct",
      "type": "boolean"
    },
    "process_correct": {
      "title": "Process Correct",
      "type": "boolean"
    },
    "repair_suggestion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repair Suggestion"
    }
  },
  "required": [
    "error_type",
    "confidence",
    "final_result_correct",
    "process_correct"
  ],
  "title": "Diagnosis",
  "type": "object"
}
