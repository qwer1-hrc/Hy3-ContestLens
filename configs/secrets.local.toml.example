[hy3]
api_key = ""
base_url = "http://127.0.0.1:8001/v1"
model = "hy3"
reasoning_effort = "medium"
temperature = 0.2
top_p = 0.95
max_tokens = 8192
response_format = "json_schema"
# Total attempts per model call, including the first request (1-5).
max_attempts = 3
retry_backoff_seconds = 1.0

# Optional report-only connection overrides; absent values inherit from [hy3].
# Numeric budgets normally live in configs/app.toml [report_translation].
[report_translation]
# api_key = ""
# base_url = "http://127.0.0.1:8001/v1"
# model = "hy3"

# Optional vision model: never inherits anything from [hy3].
# Leave api_key empty to keep the original text-only workflow.
[image_understanding]
api_key = ""
base_url = "https://api.moonshot.cn/v1"
model = "kimi-k3"
